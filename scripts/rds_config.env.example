# AWS RDS 연결 설정
# 실제 사용 시 rds_config.env로 복사하여 실제 값을 입력하세요

# RDS 엔드포인트 (예: your-rds-instance.xxxxxx.ap-northeast-2.rds.amazonaws.com)
DB_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com

# RDS 포트 (기본값: 5432)
DB_PORT=5432

# RDS 마스터 사용자명
DB_USER=postgres

# RDS 마스터 비밀번호
DB_PASSWORD=your-secure-password

# 생성할 데이터베이스명
DB_NAME=youth_policy

# AWS 관련 설정 (선택사항)
AWS_REGION=ap-northeast-2
AWS_ENVIRONMENT=true 
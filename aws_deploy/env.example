# AWS 배포용 환경 변수 설정 예시

# OpenAI API 설정
OPENAI_API_KEY=your_openai_api_key_here

# AWS 설정
AWS_REGION=ap-northeast-2
AWS_ENVIRONMENT=true

# S3 설정
S3_BUCKET_NAME=youth-policy-vectordb
S3_VECTORDB_KEY=vector_db_openai_large_combined

# 데이터베이스 설정 (RDS)
DB_NAME=youth_policy
DB_USER=postgres
DB_PASSWORD=${aws_secretsmanager_secret_db_password}
DB_HOST=${rds_endpoint}
DB_PORT=5432

# 애플리케이션 설정
PORT=8000
LOG_LEVEL=INFO

# 프로젝트 설정
PROJECT_NAME=youth-policy-api 